            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:fillColor="#00000000"
            android:pathData="M 32,83 C 34,78 38,72 40,70 C 28,58 28,45 42,32 C 52,22 68,20 78,24 C 74,38 72,56 58,66 C 48,73 41,71 40,70">
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:type="linear"
                    android:startX="32"
                    android:startY="83"
                    android:endX="78"
                    android:endY="24">
                    <item android:color="#D946EF" android:offset="0.0" />
                    <item android:color="#A855F7" android:offset="0.3" />
                    <item android:color="#3B82F6" android:offset="0.65" />
                    <item android:color="#06B6D4" android:offset="0.85" />
                    <item android:color="#22D3EE" android:offset="1.0" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Center Clock Circle -->
        <path
            android:strokeWidth="2.8"
            android:fillColor="#00000000"
            android:pathData="M 48,50 A 2.5,2.5 0 1,1 53,50 A 2.5,2.5 0 1,1 48,50">
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:type="linear"
                    android:startX="45"
                    android:startY="55"
                    android:endX="55"
                    android:endY="45">
                    <item android:color="#A855F7" android:offset="0.0" />
                    <item android:color="#3B82F6" android:offset="1.0" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Minute Hand (pointing top-right) -->
        <path
            android:strokeWidth="3.2"
            android:strokeLineCap="round"
            android:pathData="M 52,48 L 68,32">
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:type="linear"
                    android:startX="52"
                    android:startY="48"
                    android:endX="68"
                    android:endY="32">
                    <item android:color="#3B82F6" android:offset="0.0" />
                    <item android:color="#22D3EE" android:offset="1.0" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Hour Hand (pointing top-left) -->
        <path
            android:strokeWidth="3.2"
            android:strokeLineCap="round"
            android:pathData="M 48,48 L 40,40">
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:type="linear"
                    android:startX="48"
                    android:startY="48"
                    android:endX="40"
                    android:endY="40">
                    <item android:color="#A855F7" android:offset="0.0" />
                    <item android:color="#3B82F6" android:offset="1.0" />
